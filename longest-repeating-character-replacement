class Solution:
    def characterReplacement(self, s: str, k: int) -> int:
        count = {}
        low = 0
        max_freq = 0
        max_len = 0
        result = 0
        for right in range(len(s)):
            count[s[right]] = count.get(s[right], 0) + 1
            max_freq = max(max_freq, count[s[right]])
            while (right - low +1) - max_freq > k :
                count[s[low]] -= 1
                low += 1
            
            result = max(result, right- low +1) 
        return result
        
